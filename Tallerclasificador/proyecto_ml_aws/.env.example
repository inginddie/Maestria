# AWS Configuration
AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui
AWS_REGION=us-east-1

# S3 Bucket
S3_BUCKET_NAME=industrial-classification-bucket

# SageMaker
SAGEMAKER_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/SageMakerRole
SAGEMAKER_INSTANCE_TYPE=ml.m5.xlarge

# RDS Database
RDS_HOST=your-rds-endpoint.rds.amazonaws.com
RDS_PORT=3306
RDS_DATABASE=predictions_db
RDS_USERNAME=admin
RDS_PASSWORD=tu_password_aqui

# Model Parameters
IMAGE_SIZE=224
BATCH_SIZE=32
EPOCHS=10
LEARNING_RATE=0.0001
CONFIDENCE_THRESHOLD=0.75
